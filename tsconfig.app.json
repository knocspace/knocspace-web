{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* 경로 별칭 — vite.config.ts 의 resolve.alias 와 짝을 맞춘다 */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* .storybook 도 함께 검사한다. preview.tsx 가 JSX 와 `@` 별칭을 쓰므로
   * node 쪽이 아니라 여기다.
   *
   * 디렉터리 이름만 적으면 안 되고 아래처럼 글로브까지 써야 한다. tsc 는
   * 디렉터리를 "그 아래 전부" 글로브로 넓히는데, 이 확장이 `.` 으로 시작하는
   * 숨김 디렉터리를 건너뛴다. 그러면 preview.tsx 가 프로그램에 안 들어가고
   * 에디터가 이 파일을 inferred project 로 열어 `@/*` 별칭을 못 찾는다. */
  "include": ["src", ".storybook/**/*"]
}
